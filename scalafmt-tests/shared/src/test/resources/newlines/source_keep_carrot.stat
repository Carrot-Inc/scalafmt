<<< carrot 7.3: multiline-pattern case arrow keeps hand padding; single-line arrows stay aligner-managed
object a:
  def f(x: T): Int = x match
    case (_, Some(e), _)      => 1
    case (Some(_), _, _)
       | (_, _, Some(_))      => 2
    case (None, None, None)   => 3
>>>
object a:
  def f(x: T): Int = x match
    case (_, Some(e), _)      => 1
    case (Some(_), _, _)
       | (_, _, Some(_))      => 2
    case (None, None, None)   => 3
