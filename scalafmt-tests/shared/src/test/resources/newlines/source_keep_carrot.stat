runner.dialect = scala3
maxColumn = 120
newlines.source = keep
newlines.inInterpolation = keep
docstrings.style = keep
newlines.configStyle.defnSite {
  prefer = true
  forceIfOptimized = false
  preferBreakBeforeClose = true
}
danglingParentheses.defnSite = false
danglingParentheses.callSite = false
newlines.configStyle.callSite {
  prefer = true
  forceIfOptimized = false
  preferBreakBeforeClose = true
}
align.openParenDefnSite = true
continuationIndent.defnSite = 2
spaces.preserveBefore = ["->"]
spaces.afterAccessModifier = true
spaces.beforeContextBoundColon = IfMultipleBounds
align.enumeratorsAcrossBlankLines = true
align.multiline = true
align.multilineMembers = true
align.allowOverflow = true
align.tokenCategory."Equals" = "Assign"
align.tokenCategory."LeftArrow" = "Assign"
align.tokens."+" = [{ code = "<-" }, { code = "=", owners = [{ regex = "Enumerator\\.Val" }] }, { code = ":", owners = [{ regex = "Term\\.Param", parents = ["Ctor\\.Primary"] }], onlyIfClauseBroken = true, onlyIfCaseClassParam = true }, { code = "extends", owners = [{ regex = "Defn\\.EnumCase" }], onlyIfOwnerStartsLine = true }]
trailingCommas = keep
indent.ctrlBodyIndentOnlyIfBroken = true
indent.preservePatAltIndent = true
indent.preserveParamClauseIndent = true
indent.preserveAssignIndent = true
indent.preserveInfixIndent = true
rewrite.scala3.convertToNewSyntax = true
rewrite.scala3.removeOptionalBraces.enabled = true
rewrite.rules = [RedundantBraces]
rewrite.redundantBraces.stringInterpolation = true
<<< carrot 1.1: braceless for-yield after = stays inline under keep
