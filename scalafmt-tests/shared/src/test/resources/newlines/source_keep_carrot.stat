<<< carrot 14.1: for-comprehension aligns as one table across blank lines
object a:
  def f = for
    reqId <- generateRequestId
    credentials <- getStoredCredentials
    backendBundle = selectBackendUrlBundle(credentials)

    tryWithBasePath = (basePath: String) =>
      fetch(basePath)

    result <-
      if retry then tryWithBasePath(primary)
      else tryWithBasePath(secondary)
  yield result
>>>
object a:
  def f = for
    reqId          <- generateRequestId
    credentials    <- getStoredCredentials
    backendBundle   = selectBackendUrlBundle(credentials)

    tryWithBasePath = (basePath: String) =>
      fetch(basePath)

    result         <-
      if retry then tryWithBasePath(primary)
      else tryWithBasePath(secondary)
  yield result
