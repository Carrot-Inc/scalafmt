runner.dialect = scala3
maxColumn = 120
newlines.source = keep
newlines.configStyle.defnSite {
  prefer = true
  forceIfOptimized = false
  preferBreakBeforeClose = true
}
danglingParentheses.defnSite = false
align.openParenDefnSite = true
continuationIndent.defnSite = 2
spaces.preserveBefore = ["->"]
trailingCommas = keep
indent.caseBodyIndentOnlyIfBroken = true
rewrite.scala3.convertToNewSyntax = true
rewrite.scala3.removeOptionalBraces.enabled = true
<<< carrot 1.1: braceless for-yield after = stays inline under keep
object a:
  def forOnTheSameLine(param: String): Task[Int] = for
    unused <- Console.printLine("test")
  yield 9
>>>
object a:
  def forOnTheSameLine(param: String): Task[Int] = for
    unused <- Console.printLine("test")
  yield 9
<<< carrot 1.2: for on next line after = stays broken under keep
object a:
  val dumbTask: Task[Unit] =
    for
      unused <- Console.printLine("hello")
    yield ()
>>>
object a:
  val dumbTask: Task[Unit] =
    for
      unused <- Console.printLine("hello")
    yield ()
<<< carrot 1.3: match after = stays inline under keep (control)
object a:
  def m(param: String): Boolean = param match
    case "yes" => true
    case _ => false
>>>
object a:
  def m(param: String): Boolean = param match
    case "yes" => true
    case _     => false
<<< carrot 2.1: source-dangled close implies config style, blank line squashed
object a:
  final case class ThreeParamsFormatVerically( short: Int,
    bitLonger: Boolean,
    byFarTheLongest: Option[Long]

                       )
>>>
object a:
  final case class ThreeParamsFormatVerically(
    short: Int,
    bitLonger: Boolean,
    byFarTheLongest: Option[Long]
  )
<<< carrot 2.2: source-inline close keeps params aligned under open paren
object a:
  final class NotACaseClass(param1: Int,
                            param2: Option[Long]):
    def memberFunction = -1
>>>
object a:
  final class NotACaseClass(param1: Int,
                            param2: Option[Long]):
    def memberFunction = -1
<<< carrot 2.3: overflowing one-line def breaks aligned under paren, close stays inline
object a:
  def functionWithALotOfParams(firstParam: Int, secondParam: String, thirdParam: Double, fourthParam: Option[ArrayIndexOutOfBoundsException]): String =
    "Result"
>>>
object a:
  def functionWithALotOfParams(firstParam: Int,
                               secondParam: String,
                               thirdParam: Double,
                               fourthParam: Option[ArrayIndexOutOfBoundsException]): String =
    "Result"
<<< carrot 2.4: comment after = must not dangle the close (idempotency guard)
object a:
  def renderSubcategory(subcategory: String,
                        yellow: Boolean): VdomElement = // TODO
    someBody(subcategory, yellow)
>>>
object a:
  def renderSubcategory(subcategory: String,
                        yellow: Boolean): VdomElement = // TODO
    someBody(subcategory, yellow)
<<< carrot 2.5: fitting one-line defn sites stay on one line
object a:
  final case class ThreeParamStayInline(value1: Int, value2: String, value3: Option[Double])
  def postNote(locationId: CarrotLocationId, customerId: CarrotCustomerId, text: String, uuid: UUID): ApiTask[Note] =
    post(locationId, customerId, text, uuid)
>>>
object a:
  final case class ThreeParamStayInline(value1: Int, value2: String, value3: Option[Double])
  def postNote(locationId: CarrotLocationId, customerId: CarrotCustomerId, text: String, uuid: UUID): ApiTask[Note] =
    post(locationId, customerId, text, uuid)
<<< carrot 3.1: hand-aligned -> table stays aligned (spaces.preserveBefore)
val m = Map(
  "a"        -> 1,
  "long-key" -> 2,
)
>>>
val m = Map(
  "a"        -> 1,
  "long-key" -> 2,
)
<<< carrot 3.2: unaligned -> table stays unaligned (spaces.preserveBefore)
val m = Map(
  "a" -> 1,
  "long-key" -> 2,
)
>>>
val m = Map(
  "a" -> 1,
  "long-key" -> 2,
)
<<< carrot 3.3: imperfect -> padding is preserved verbatim, not recomputed
val m = Map(
  "a"    -> 1,
  "long-key"   -> 2,
)
>>>
val m = Map(
  "a"    -> 1,
  "long-key"   -> 2,
)
<<< carrot 4.1: single-line anon-class braces stay inline under keep
object a:
  def download(text: String, mimeType: String): Unit =
    val blob = new Blob(js.Array(text), new BlobPropertyBag { `type` = mimeType })
    use(blob)
>>>
object a:
  def download(text: String, mimeType: String): Unit =
    val blob = new Blob(js.Array(text), new BlobPropertyBag { `type` = mimeType })
    use(blob)
<<< carrot 4.2: multi-line template braces still convert to colon syntax
object a:
  val bag = new BlobPropertyBag {
    `type` = mimeType
    endings = "transparent"
  }
>>>
object a:
  val bag = new BlobPropertyBag:
    `type` = mimeType
    endings = "transparent"
<<< carrot 5.1: chain under inline case body anchors at case line + main
object a:
  def f(x: Option[Int]): Option[Int] = x match
    case Some(_) => (a, b, c)
      .mapN(g)
      .map(h)
    case None => none
>>>
object a:
  def f(x: Option[Int]): Option[Int] = x match
    case Some(_) => (a, b, c)
      .mapN(g)
      .map(h)
    case None => none
<<< carrot 5.2: broken case body still gets one body indent
object a:
  def f(x: Option[Int]): Option[Int] = x match
    case Some(_) =>
      (a, b, c)
        .mapN(g)
    case None => none
>>>
object a:
  def f(x: Option[Int]): Option[Int] = x match
    case Some(_) =>
      (a, b, c)
        .mapN(g)
    case None => none
<<< carrot 5.3: multiline pattern keeps caseSite indent with deferred body
object a:
  def f(x: Option[Int]): Boolean = x match
    case Some(1) |
        Some(2) => true
    case _ => false
>>>
object a:
  def f(x: Option[Int]): Boolean = x match
    case Some(1) |
        Some(2) => true
    case _ => false
